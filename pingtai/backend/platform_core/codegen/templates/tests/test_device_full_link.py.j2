    def test_adapter_conversion(self) -> bool:
        """测试适配器转换"""
        test_name = "适配器转换测试"
        logger.info(f"开始测试: {test_name}")
        
        try:
            # 创建平台设备
            connection_params = {{ class_name }}Adapter.create_connection_params(
                {% if spec.communication == 'rs485' %}
                port='COM3',
                baudrate=9600
                {% elif spec.communication == 'tcp' %}
                host='192.168.1.100',
                port=502
                {% elif spec.communication == 'can' %}
                channel='can0',
                bitrate=500000
                {% endif %}
            )
            
            device_params = {{ class_name }}Adapter.create_device_params()
            
            self.platform_device = {{ class_name }}Adapter.to_platform_device(
                station_id=1,
                device_code="{{ device_name.upper() }}-001",
                device_name="{{ spec.description | default(device_name + ' 设备') }}",
                protocol=ProtocolType.{{ spec.protocol | default('MODBUS_RTU') | upper }},
                connection_params=connection_params,
                device_params=device_params
            )
            
            # 验证设备创建
            assert self.platform_device is not None
            assert self.platform_device.code == "{{ device_name.upper() }}-001"
            assert self.platform_device.name == "{{ spec.description | default(device_name + ' 设备') }}"
            assert self.platform_device.device_type.value == "{{ device_name }}"
            
            # 测试反向转换
            device_dto = {{ class_name }}Adapter.from_platform_device(self.platform_device)
            assert device_dto['device_id'] == self.platform_device.id
            assert device_dto['code'] == "{{ device_name.upper() }}-001"
            
            logger.info(f"[PASS] {test_name}")
            self.test_results.append((test_name, True))
            return True
            
        except Exception as e:
            logger.error(f"[FAIL] {test_name}: {e}")
            import traceback
            traceback.print_exc()
            self.test_results.append((test_name, False))
            return False
    
    def test_communication_layer(self) -> bool:
        """测试通信层"""
        test_name = "通信层测试"
        logger.info(f"开始测试: {test_name}")
        
        try:
            # 创建通信层
            {% if spec.communication == 'rs485' %}
            self.comm = CommFactory.create('rs485', port='COM3', baudrate=9600)
            {% elif spec.communication == 'tcp' %}
            self.comm = CommFactory.create('tcp', host='192.168.1.100', port=502)
            {% elif spec.communication == 'can' %}
            self.comm = CommFactory.create('can', channel='can0', bitrate=500000)
            {% else %}
            self.comm = CommFactory.create('rs485', port='COM3', baudrate=9600)
            {% endif %}
            
            # 创建协议层
            {% if spec.protocol == 'modbus_rtu' %}
            self.protocol = ProtocolFactory.create('modbus_rtu', comm=self.comm, slave_id=1)
            {% elif spec.protocol == 'modbus_tcp' %}
            self.protocol = ProtocolFactory.create('modbus_tcp', comm=self.comm)
            {% else %}
            self.protocol = ProtocolFactory.create('modbus_rtu', comm=self.comm, slave_id=1)
            {% endif %}
            
            # 验证创建
            assert self.comm is not None
            assert self.protocol is not None
            
            logger.info(f"[PASS] {test_name}")
            self.test_results.append((test_name, True))
            return True
            
        except Exception as e:
            logger.error(f"[FAIL] {test_name}: {e}")
            import traceback
            traceback.print_exc()
            self.test_results.append((test_name, False))
            return False
    
