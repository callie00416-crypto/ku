    def test_device_lifecycle(self) -> bool:
        """测试设备生命周期"""
        test_name = "设备生命周期测试"
        logger.info(f"开始测试: {test_name}")
        
        try:
            # 测试连接
            logger.info("测试设备连接...")
            # 注意：这里需要模拟连接，实际测试需要真实硬件
            # self.{{ device_name }}.connect()
            # assert self.{{ device_name }}.is_connected
            
            # 模拟连接成功
            self.{{ device_name }}._is_connected = True
            self.{{ device_name }}._device_status = "connected"
            
            logger.info("设备已连接")
            
            # 测试健康检查
            logger.info("测试健康检查...")
            health = self.{{ device_name }}.health_check()
            assert health['health_status'] == 'healthy'
            assert health['is_connected'] is True
            
