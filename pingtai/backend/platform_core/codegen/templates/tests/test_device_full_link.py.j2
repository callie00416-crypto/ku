    def test_platform_integration(self) -> bool:
        """测试平台集成"""
        test_name = "平台集成测试"
        logger.info(f"开始测试: {test_name}")
        
        try:
            # 验证平台设备状态同步
            assert self.platform_device is not None
            
            # 测试状态映射
            status = {{ class_name }}Adapter.map_device_status('connected')
            assert status == 'connected'
            
            # 测试类型映射
            device_type = {{ class_name }}Adapter.map_device_type('{{ device_name }}')
            assert device_type.value == '{{ device_name }}'
            
            logger.info(f"[PASS] {test_name}")
            self.test_results.append((test_name, True))
